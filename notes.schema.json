{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whispers notes data",
  "type": "object",
  "required": [
    "version",
    "noteLibrary",
    "people",
    "others"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "noteLibrary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "noteIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "screening": {
            "type": "object",
            "required": [
              "question",
              "answerHashes"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answerHashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "noteIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "others": {
      "type": "object",
      "required": [
        "noteIds"
      ],
      "properties": {
        "noteIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "required": [
        "id",
        "message",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
